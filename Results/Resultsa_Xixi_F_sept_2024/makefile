file_name=Results_Xixi_F_sep_2024_v2.txt

results:
	grep "file_name" ${file_name} | awk '{print $$9}'
	grep "Query size" ${file_name} | awk '{print $$9}'
	grep ": Query:" ${file_name}
	grep "Query found" ${file_name} | awk '{print $$9}'
	grep "time" ${file_name} | awk '{print $$9}'
	grep "file_name\|deletes" Results_Xixi_F_sep_2024_v2.txt
